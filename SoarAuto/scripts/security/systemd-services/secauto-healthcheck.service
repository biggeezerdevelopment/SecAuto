[Unit]
Description=SecAuto Health Check Monitor
Documentation=https://github.com/your-org/secauto
After=secauto.service
Requires=secauto.service

[Service]
Type=oneshot

# Health check script execution
ExecStart=/bin/bash -c '\
    JAIL_PATH="/opt/secauto-jail"; \
    API_PORT=${SECAUTO_API_PORT:-9090}; \
    MAX_ATTEMPTS=3; \
    ATTEMPT=0; \
    \
    echo "Starting SecAuto health check..."; \
    \
    # Check if SecAuto service is running \
    if ! systemctl is-active --quiet secauto.service; then \
        echo "ERROR: SecAuto service is not running"; \
        exit 1; \
    fi; \
    \
    # Check if API port is listening \
    if ! netstat -tln | grep -q ":$API_PORT "; then \
        echo "ERROR: SecAuto API port $API_PORT is not listening"; \
        exit 1; \
    fi; \
    \
    # Check API health endpoint \
    while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do \
        if curl -s -f --max-time 10 "http://localhost:$API_PORT/health" >/dev/null 2>&1; then \
            echo "SUCCESS: SecAuto API health check passed"; \
            \
            # Additional checks \
            echo "Checking jail environment..."; \
            if [ -d "$JAIL_PATH/opt/secauto" ]; then \
                echo "SUCCESS: Jail environment is intact"; \
            else \
                echo "WARNING: Jail environment issue detected"; \
            fi; \
            \
            echo "Checking resource usage..."; \
            MEMORY_USAGE=$(ps -o pid,ppid,cmd,%mem --sort=-%mem -C secauto | tail -n +2 | awk "{ print \$4 }" | head -1); \
            if [ -n "$MEMORY_USAGE" ]; then \
                echo "INFO: SecAuto memory usage: ${MEMORY_USAGE}%"; \
                if (( $(echo "$MEMORY_USAGE > 80" | bc -l) )); then \
                    echo "WARNING: High memory usage detected"; \
                fi; \
            fi; \
            \
            echo "Health check completed successfully"; \
            exit 0; \
        fi; \
        \
        ATTEMPT=$((ATTEMPT + 1)); \
        echo "Health check attempt $ATTEMPT failed, retrying in 5 seconds..."; \
        sleep 5; \
    done; \
    \
    echo "ERROR: SecAuto API health check failed after $MAX_ATTEMPTS attempts"; \
    \
    # Collect diagnostic information \
    echo "=== Diagnostic Information ==="; \
    echo "Service status:"; \
    systemctl status secauto.service --no-pager -l; \
    echo ""; \
    echo "Recent logs:"; \
    journalctl -u secauto.service --no-pager -l --since="5 minutes ago"; \
    echo ""; \
    echo "Network connections:"; \
    netstat -tln | grep ":$API_PORT"; \
    echo ""; \
    echo "Process information:"; \
    ps aux | grep secauto; \
    \
    exit 1'

# Notification on failure (optional)
ExecStartPost=/bin/bash -c '\
    if [ $EXIT_STATUS -ne 0 ]; then \
        echo "SecAuto health check failed - consider alerting"; \
        # Add your notification logic here (email, Slack, etc.) \
        # logger -p daemon.error "SecAuto health check failed"; \
    fi'

# Environment
Environment=SECAUTO_API_PORT=9090

# Security
User=nobody
Group=nogroup
PrivateTmp=yes
ProtectSystem=yes
ProtectHome=yes
NoNewPrivileges=yes
ReadOnlyPaths=/
ReadWritePaths=/tmp

# Resource limits
MemoryMax=64M
CPUQuota=10%
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target