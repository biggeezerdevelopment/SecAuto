[Unit]
Description=SecAuto Health Check Timer
Documentation=https://github.com/your-org/secauto
Requires=secauto-healthcheck.service

[Timer]
# Run health check 2 minutes after boot
OnBootSec=2min

# Run health check every 2 minutes while system is running
OnUnitActiveSec=2min

# Run health check every 2 minutes based on calendar time (fallback)
OnCalendar=*:0/2

# Ensure timer is persistent across reboots
Persistent=yes

# Add randomization to prevent thundering herd
RandomizedDelaySec=30

[Install]
WantedBy=timers.target