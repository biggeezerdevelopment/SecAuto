[Unit]
Description=SecAuto SOAR Automation Platform (Secure Jail Environment)
Documentation=https://github.com/your-org/secauto
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/secauto-jail

[Service]
Type=simple
User=root
Group=root

# Pre-start: Ensure jail environment is ready
ExecStartPre=/bin/bash -c 'mkdir -p /opt/secauto-jail/var/{run,log} && chown secauto:secauto /opt/secauto-jail/var/{run,log}'
ExecStartPre=/bin/bash -c 'mkdir -p /opt/secauto-jail/tmp && chown secauto:secauto /opt/secauto-jail/tmp'

# Main service: Run SecAuto in chroot jail as secauto user
ExecStart=/usr/bin/chroot /opt/secauto-jail /bin/su -s /opt/secauto/secauto secauto

# Graceful shutdown
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Working directory inside jail
WorkingDirectory=/opt/secauto

# Environment variables
Environment=SECAUTO_CONFIG=/opt/secauto/config.yaml
Environment=SECAUTO_JAIL=true
Environment=SECAUTO_LOG_LEVEL=INFO
Environment=PYTHONPATH=/opt/secauto/Venv/lib/python3.9/site-packages

# Security Hardening - Maximum Security
## Prevent privilege escalation
NoNewPrivileges=yes

## File system protection
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/secauto-jail
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

## Process and memory protection
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes

## Network restrictions
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=0.0.0.0/0

## System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @cpu-emulation @obsolete @privileged @reboot @swap @raw-io
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

## Resource limits
LimitNOFILE=8192
LimitNPROC=256
LimitFSIZE=2G
LimitCORE=0
LimitMEMLOCK=0

## Memory and CPU limits
MemoryMax=2G
MemoryHigh=1.5G
CPUQuota=80%
TasksMax=1024

## Capabilities - Remove all capabilities
CapabilityBoundingSet=
AmbientCapabilities=

## Additional security
LockPersonality=yes
RestrictNamespaces=yes
UMask=0077

[Install]
WantedBy=multi-user.target