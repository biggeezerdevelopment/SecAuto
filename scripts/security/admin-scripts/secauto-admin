#!/bin/bash
#
# SecAuto Administration Script
# Provides secure management interface for SecAuto in jail environment
#
# Usage: secauto-admin [COMMAND] [OPTIONS]
#

set -e

# Configuration
JAIL_PATH="/opt/secauto-jail"
SECAUTO_USER="secauto"
SERVICE_NAME="secauto"
API_PORT="9090"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_debug() { echo -e "${BLUE}[DEBUG]${NC} $1"; }

# Check if running as root when needed
check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This command requires root privileges (use sudo)"
        exit 1
    fi
}

# Validate jail environment
validate_jail() {
    if [[ ! -d "$JAIL_PATH" ]]; then
        log_error "Jail environment not found at $JAIL_PATH"
        log_error "Run the secure installation script first"
        exit 1
    fi
    
    if [[ ! -f "$JAIL_PATH/opt/secauto/secauto" ]]; then
        log_error "SecAuto binary not found in jail"
        exit 1
    fi
}

# Show help
show_help() {
    cat << EOF
SecAuto Administration Script

Usage: secauto-admin [COMMAND] [OPTIONS]

SYSTEM COMMANDS:
  status                Show service status and health
  start                 Start SecAuto service
  stop                  Stop SecAuto service  
  restart               Restart SecAuto service
  logs [LINES]          View SecAuto logs (default: 50 lines)
  follow-logs           Follow live logs

JAIL ENVIRONMENT:
  shell                 Enter jail shell environment
  python [SCRIPT]       Run Python script in jail environment
  install-package PKG   Install Python package in venv
  list-packages         List installed Python packages
  venv-status          Show virtual environment status

SECURITY & MONITORING:
  security-check        Run security validation checks
  health-check          Perform manual health check
  resource-usage        Show current resource usage
  api-test              Test API connectivity and authentication

DATA MANAGEMENT:
  backup [DEST]         Create backup of SecAuto data
  restore BACKUP        Restore from backup file
  list-automations      List uploaded automation scripts
  list-integrations     List integration configurations
  list-playbooks        List uploaded playbooks

CONFIGURATION:
  show-config           Display current configuration (sanitized)
  validate-config       Validate configuration file
  reload-config         Reload configuration (restart required)
  generate-api-key      Generate new API key

MAINTENANCE:
  clean-logs            Clean old log files
  clean-temp            Clean temporary files
  check-permissions     Verify file permissions
  update-jail           Update jail environment

HELP:
  help                  Show this help message
  version               Show SecAuto version information

Examples:
  secauto-admin status
  secauto-admin logs 100
  secauto-admin python /opt/secauto/automations/test.py
  secauto-admin install-package requests
  secauto-admin backup /tmp/secauto-backup.tar.gz

EOF
}

# Service management commands
cmd_status() {
    echo "=== SecAuto Service Status ==="
    systemctl status $SERVICE_NAME --no-pager -l
    echo ""
    
    echo "=== API Health Check ==="
    if curl -s -f --max-time 5 "http://localhost:$API_PORT/health" >/dev/null 2>&1; then
        log_info "API is responding"
        curl -s "http://localhost:$API_PORT/health" | python3 -m json.tool 2>/dev/null || echo "API response received"
    else
        log_warn "API is not responding"
    fi
    echo ""
    
    echo "=== Resource Usage ==="
    cmd_resource_usage
}

cmd_start() {
    check_root
    log_info "Starting SecAuto service..."
    systemctl start $SERVICE_NAME
    systemctl start secauto-firewall.service 2>/dev/null || true
    sleep 2
    cmd_status
}

cmd_stop() {
    check_root
    log_info "Stopping SecAuto service..."
    systemctl stop $SERVICE_NAME
    systemctl stop secauto-firewall.service 2>/dev/null || true
}

cmd_restart() {
    check_root
    log_info "Restarting SecAuto service..."
    systemctl restart $SERVICE_NAME
    systemctl restart secauto-firewall.service 2>/dev/null || true
    sleep 3
    cmd_status
}

cmd_logs() {
    local lines=${1:-50}
    echo "=== SecAuto Service Logs (last $lines lines) ==="
    journalctl -u $SERVICE_NAME --no-pager -l -n "$lines"
    
    if [[ -f "$JAIL_PATH/opt/secauto/logs/secauto.log" ]]; then
        echo ""
        echo "=== SecAuto Application Logs (last $lines lines) ==="
        tail -n "$lines" "$JAIL_PATH/opt/secauto/logs/secauto.log" || log_warn "Could not read application logs"
    fi
}

cmd_follow_logs() {
    log_info "Following SecAuto logs (Ctrl+C to exit)..."
    echo "Service logs:"
    journalctl -u $SERVICE_NAME -f &
    SERVICE_PID=$!
    
    if [[ -f "$JAIL_PATH/opt/secauto/logs/secauto.log" ]]; then
        echo "Application logs:"
        tail -f "$JAIL_PATH/opt/secauto/logs/secauto.log" &
        APP_PID=$!
    fi
    
    # Wait for interrupt
    trap 'kill $SERVICE_PID 2>/dev/null || true; kill $APP_PID 2>/dev/null || true; exit 0' INT
    wait
}

# Jail environment commands
cmd_shell() {
    check_root
    validate_jail
    log_info "Entering SecAuto jail environment..."
    log_info "Type 'exit' to return to host system"
    chroot "$JAIL_PATH" /bin/bash
}

cmd_python() {
    check_root
    validate_jail
    local script="$1"
    
    if [[ -n "$script" ]]; then
        log_info "Running Python script: $script"
        chroot "$JAIL_PATH" /opt/secauto/Venv/bin/python "$script"
    else
        log_info "Starting Python interactive shell in jail..."
        log_info "Type 'exit()' to return to host system"
        chroot "$JAIL_PATH" /opt/secauto/Venv/bin/python
    fi
}

cmd_install_package() {
    check_root
    validate_jail
    local package="$1"
    
    if [[ -z "$package" ]]; then
        log_error "Package name required"
        echo "Usage: secauto-admin install-package <package-name>"
        exit 1
    fi
    
    log_info "Installing Python package: $package"
    chroot "$JAIL_PATH" /opt/secauto/Venv/bin/pip install "$package"
}

cmd_list_packages() {
    check_root
    validate_jail
    log_info "Installed Python packages:"
    chroot "$JAIL_PATH" /opt/secauto/Venv/bin/pip list
}

cmd_venv_status() {
    validate_jail
    echo "=== Python Virtual Environment Status ==="
    echo "Venv Path: $JAIL_PATH/opt/secauto/Venv"
    
    if [[ -f "$JAIL_PATH/opt/secauto/Venv/bin/python" ]]; then
        log_info "Python virtual environment is available"
        if [[ $EUID -eq 0 ]]; then
            echo "Python Version: $(chroot "$JAIL_PATH" /opt/secauto/Venv/bin/python --version)"
            echo "Pip Version: $(chroot "$JAIL_PATH" /opt/secauto/Venv/bin/pip --version)"
        fi
    else
        log_error "Python virtual environment not found"
    fi
    
    echo "Permissions:"
    ls -la "$JAIL_PATH/opt/secauto/Venv/" 2>/dev/null | head -5 || log_warn "Could not check permissions"
}

# Security and monitoring commands
cmd_security_check() {
    log_info "Running security validation checks..."
    
    echo "=== Jail Environment Security ==="
    # Check jail permissions
    if [[ $(stat -c %U "$JAIL_PATH") != "root" ]]; then
        log_error "Jail root directory should be owned by root"
    else
        log_info "Jail root permissions: OK"
    fi
    
    # Check SecAuto files permissions
    if [[ $(stat -c %U "$JAIL_PATH/opt/secauto") != "$SECAUTO_USER" ]]; then
        log_warn "SecAuto directory should be owned by $SECAUTO_USER"
    else
        log_info "SecAuto directory permissions: OK"
    fi
    
    echo ""
    echo "=== Service Security ==="
    # Check if service is running as correct user
    if systemctl is-active --quiet $SERVICE_NAME; then
        local running_user=$(ps -o user= -p $(systemctl show --property MainPID --value $SERVICE_NAME) 2>/dev/null || echo "unknown")
        if [[ "$running_user" == "$SECAUTO_USER" ]] || [[ "$running_user" == "root" ]]; then
            log_info "Service user: OK ($running_user)"
        else
            log_warn "Service running as unexpected user: $running_user"
        fi
    fi
    
    echo ""
    echo "=== Network Security ==="
    # Check if API port is properly restricted
    if netstat -tln | grep -q ":$API_PORT "; then
        log_info "API port $API_PORT is listening"
        if iptables -L INPUT -n | grep -q "$API_PORT"; then
            log_info "Firewall rules for API port: OK"
        else
            log_warn "No firewall rules found for API port"
        fi
    else
        log_warn "API port $API_PORT is not listening"
    fi
}

cmd_health_check() {
    log_info "Performing manual health check..."
    
    # Check service status
    if systemctl is-active --quiet $SERVICE_NAME; then
        log_info "Service is active"
    else
        log_error "Service is not running"
        return 1
    fi
    
    # Check API health
    if curl -s -f --max-time 10 "http://localhost:$API_PORT/health" >/dev/null; then
        log_info "API health check: PASSED"
        curl -s "http://localhost:$API_PORT/health" | python3 -m json.tool 2>/dev/null || true
    else
        log_error "API health check: FAILED"
        return 1
    fi
    
    log_info "Manual health check completed successfully"
}

cmd_resource_usage() {
    echo "=== Resource Usage ==="
    
    # Memory usage
    if systemctl is-active --quiet $SERVICE_NAME; then
        local main_pid=$(systemctl show --property MainPID --value $SERVICE_NAME)
        if [[ "$main_pid" != "0" ]]; then
            echo "Memory Usage:"
            ps -o pid,ppid,cmd,%mem,%cpu --sort=-%mem -p $main_pid 2>/dev/null | head -2
            echo ""
        fi
    fi
    
    # Disk usage
    echo "Disk Usage:"
    df -h "$JAIL_PATH" 2>/dev/null | tail -1
    echo ""
    
    # Log file sizes
    echo "Log File Sizes:"
    du -sh "$JAIL_PATH/opt/secauto/logs"/* 2>/dev/null | head -5 || echo "No log files found"
}

cmd_api_test() {
    local api_key="$1"
    
    if [[ -z "$api_key" ]]; then
        log_warn "No API key provided, attempting without authentication..."
        api_key=""
    fi
    
    echo "=== API Connectivity Test ==="
    
    # Test health endpoint (usually doesn't require auth)
    log_info "Testing health endpoint..."
    if curl -s -f --max-time 10 "http://localhost:$API_PORT/health"; then
        echo ""
        log_info "Health endpoint: OK"
    else
        echo ""
        log_error "Health endpoint: FAILED"
    fi
    
    # Test authenticated endpoint if API key provided
    if [[ -n "$api_key" ]]; then
        echo ""
        log_info "Testing authenticated endpoint..."
        if curl -s -f --max-time 10 -H "X-API-Key: $api_key" "http://localhost:$API_PORT/playbooks" >/dev/null; then
            log_info "Authentication test: OK"
        else
            log_error "Authentication test: FAILED"
        fi
    else
        echo ""
        log_info "Skipping authentication test (no API key provided)"
        log_info "Usage: secauto-admin api-test <api-key>"
    fi
}

# Data management commands
cmd_backup() {
    check_root
    validate_jail
    local dest="${1:-/tmp/secauto-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
    
    log_info "Creating backup: $dest"
    
    cd "$JAIL_PATH/opt/secauto"
    tar -czf "$dest" \
        data/ \
        automations/ \
        integrations/ \
        playbooks/ \
        config.yaml \
        logs/ 2>/dev/null || true
    
    if [[ -f "$dest" ]]; then
        log_info "Backup created successfully: $dest"
        ls -lh "$dest"
    else
        log_error "Backup creation failed"
        exit 1
    fi
}

cmd_restore() {
    check_root
    validate_jail
    local backup_file="$1"
    
    if [[ -z "$backup_file" ]] || [[ ! -f "$backup_file" ]]; then
        log_error "Backup file required and must exist"
        echo "Usage: secauto-admin restore <backup-file>"
        exit 1
    fi
    
    log_warn "This will overwrite existing data. Continue? (y/N)"
    read -r confirm
    if [[ "$confirm" != "y" ]] && [[ "$confirm" != "Y" ]]; then
        log_info "Restore cancelled"
        exit 0
    fi
    
    log_info "Stopping SecAuto service..."
    systemctl stop $SERVICE_NAME || true
    
    log_info "Restoring from backup: $backup_file"
    cd "$JAIL_PATH/opt/secauto"
    tar -xzf "$backup_file"
    
    # Fix permissions
    chown -R "$SECAUTO_USER:$SECAUTO_USER" data/ automations/ integrations/ playbooks/ logs/ 2>/dev/null || true
    
    log_info "Starting SecAuto service..."
    systemctl start $SERVICE_NAME
    
    log_info "Restore completed"
}

cmd_list_automations() {
    validate_jail
    echo "=== Automation Scripts ==="
    if [[ -d "$JAIL_PATH/opt/secauto/automations" ]]; then
        ls -la "$JAIL_PATH/opt/secauto/automations"/*.py 2>/dev/null || echo "No automation scripts found"
    else
        log_warn "Automations directory not found"
    fi
}

cmd_list_integrations() {
    validate_jail
    echo "=== Integration Configurations ==="
    if [[ -d "$JAIL_PATH/opt/secauto/data/integrations/configs" ]]; then
        ls -la "$JAIL_PATH/opt/secauto/data/integrations/configs"/*.json 2>/dev/null || echo "No integration configs found"
    fi
    
    echo ""
    echo "=== Integration Scripts ==="
    if [[ -d "$JAIL_PATH/opt/secauto/data/integrations/scripts" ]]; then
        ls -la "$JAIL_PATH/opt/secauto/data/integrations/scripts"/*.py 2>/dev/null || echo "No integration scripts found"
    fi
}

cmd_list_playbooks() {
    validate_jail
    echo "=== Playbooks ==="
    if [[ -d "$JAIL_PATH/opt/secauto/playbooks" ]]; then
        ls -la "$JAIL_PATH/opt/secauto/playbooks"/*.json 2>/dev/null || echo "No playbooks found"
    else
        log_warn "Playbooks directory not found"
    fi
}

# Configuration commands
cmd_show_config() {
    validate_jail
    echo "=== SecAuto Configuration (Sanitized) ==="
    if [[ -f "$JAIL_PATH/opt/secauto/config.yaml" ]]; then
        # Show config but mask sensitive values
        sed 's/password:.*/password: [MASKED]/g; s/api_key:.*/api_key: [MASKED]/g; s/secret:.*/secret: [MASKED]/g' \
            "$JAIL_PATH/opt/secauto/config.yaml"
    else
        log_error "Configuration file not found"
    fi
}

cmd_validate_config() {
    check_root
    validate_jail
    log_info "Validating configuration..."
    
    # Basic YAML syntax check
    if command -v python3 >/dev/null; then
        if chroot "$JAIL_PATH" /opt/secauto/Venv/bin/python -c "
import yaml
try:
    with open('/opt/secauto/config.yaml', 'r') as f:
        yaml.safe_load(f)
    print('Configuration YAML syntax: OK')
except Exception as e:
    print(f'Configuration YAML error: {e}')
    exit(1)
" 2>/dev/null; then
            log_info "Configuration validation: PASSED"
        else
            log_error "Configuration validation: FAILED"
            exit 1
        fi
    else
        log_warn "Python not available for validation"
    fi
}

cmd_generate_api_key() {
    log_info "Generating new API key..."
    local new_key="secauto-$(openssl rand -hex 16)-$(date +%Y%m%d)"
    echo "New API key: $new_key"
    echo ""
    log_warn "Remember to:"
    log_warn "1. Add this key to config.yaml"
    log_warn "2. Restart SecAuto service"
    log_warn "3. Update client configurations"
}

# Maintenance commands
cmd_clean_logs() {
    check_root
    validate_jail
    log_info "Cleaning old log files..."
    
    # Clean systemd logs older than 30 days
    journalctl --vacuum-time=30d >/dev/null 2>&1 || true
    
    # Clean application logs older than 30 days
    find "$JAIL_PATH/opt/secauto/logs" -name "*.log.gz" -mtime +30 -delete 2>/dev/null || true
    find "$JAIL_PATH/opt/secauto/logs" -name "*.log.*" -mtime +30 -delete 2>/dev/null || true
    
    log_info "Log cleanup completed"
}

cmd_clean_temp() {
    check_root
    validate_jail
    log_info "Cleaning temporary files..."
    
    # Clean jail temp directory
    find "$JAIL_PATH/tmp" -type f -mtime +1 -delete 2>/dev/null || true
    
    # Clean any temp files in SecAuto directory
    find "$JAIL_PATH/opt/secauto" -name "*.tmp" -delete 2>/dev/null || true
    find "$JAIL_PATH/opt/secauto" -name "*.temp" -delete 2>/dev/null || true
    
    log_info "Temporary file cleanup completed"
}

cmd_check_permissions() {
    validate_jail
    echo "=== Permission Check ==="
    
    echo "Jail root directory:"
    ls -ld "$JAIL_PATH" || log_error "Cannot access jail directory"
    
    echo ""
    echo "SecAuto directory:"
    ls -ld "$JAIL_PATH/opt/secauto" || log_error "Cannot access SecAuto directory"
    
    echo ""
    echo "Key files:"
    ls -la "$JAIL_PATH/opt/secauto/secauto" 2>/dev/null || log_warn "SecAuto binary not found"
    ls -la "$JAIL_PATH/opt/secauto/config.yaml" 2>/dev/null || log_warn "Config file not found"
    ls -ld "$JAIL_PATH/opt/secauto/Venv" 2>/dev/null || log_warn "Python venv not found"
}

cmd_version() {
    echo "SecAuto Administration Script v1.0"
    echo ""
    
    validate_jail
    if [[ $EUID -eq 0 ]] && systemctl is-active --quiet $SERVICE_NAME; then
        echo "SecAuto Service Status: Running"
        # Try to get version from API
        if curl -s -f --max-time 5 "http://localhost:$API_PORT/health" | grep -q version 2>/dev/null; then
            echo "SecAuto Version: $(curl -s "http://localhost:$API_PORT/health" 2>/dev/null | grep -o '"version":"[^"]*"' | cut -d'"' -f4)"
        fi
    else
        echo "SecAuto Service Status: Not running or insufficient permissions"
    fi
}

# Main command dispatcher
case "${1:-help}" in
    # System commands
    status)         cmd_status ;;
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    logs)           cmd_logs "$2" ;;
    follow-logs)    cmd_follow_logs ;;
    
    # Jail environment
    shell)          cmd_shell ;;
    python)         cmd_python "$2" ;;
    install-package) cmd_install_package "$2" ;;
    list-packages)  cmd_list_packages ;;
    venv-status)    cmd_venv_status ;;
    
    # Security & monitoring
    security-check) cmd_security_check ;;
    health-check)   cmd_health_check ;;
    resource-usage) cmd_resource_usage ;;
    api-test)       cmd_api_test "$2" ;;
    
    # Data management
    backup)         cmd_backup "$2" ;;
    restore)        cmd_restore "$2" ;;
    list-automations) cmd_list_automations ;;
    list-integrations) cmd_list_integrations ;;
    list-playbooks) cmd_list_playbooks ;;
    
    # Configuration
    show-config)    cmd_show_config ;;
    validate-config) cmd_validate_config ;;
    generate-api-key) cmd_generate_api_key ;;
    
    # Maintenance
    clean-logs)     cmd_clean_logs ;;
    clean-temp)     cmd_clean_temp ;;
    check-permissions) cmd_check_permissions ;;
    
    # Help and info
    version)        cmd_version ;;
    help|--help|-h) show_help ;;
    
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac