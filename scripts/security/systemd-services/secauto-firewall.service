[Unit]
Description=SecAuto Firewall Rules and Network Security
Documentation=https://github.com/your-org/secauto
Before=secauto.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Firewall configuration
ExecStart=/bin/bash -c '\
    # SecAuto API port (default 9090) \
    API_PORT=${SECAUTO_API_PORT:-9090}; \
    \
    # Allow SecAuto API access from authorized networks \
    iptables -A INPUT -p tcp --dport $API_PORT -s 10.0.0.0/8 -j ACCEPT; \
    iptables -A INPUT -p tcp --dport $API_PORT -s 172.16.0.0/12 -j ACCEPT; \
    iptables -A INPUT -p tcp --dport $API_PORT -s 192.168.0.0/16 -j ACCEPT; \
    iptables -A INPUT -p tcp --dport $API_PORT -s 127.0.0.1 -j ACCEPT; \
    \
    # Block all other access to API port \
    iptables -A INPUT -p tcp --dport $API_PORT -j LOG --log-prefix "SecAuto-BLOCKED: "; \
    iptables -A INPUT -p tcp --dport $API_PORT -j DROP; \
    \
    # Rate limiting for API port \
    iptables -A INPUT -p tcp --dport $API_PORT -m limit --limit 60/min --limit-burst 10 -j ACCEPT; \
    \
    # Log and drop suspicious activity \
    iptables -A INPUT -p tcp --dport $API_PORT -m recent --set --name secauto_attacks; \
    iptables -A INPUT -p tcp --dport $API_PORT -m recent --update --seconds 300 --hitcount 20 --name secauto_attacks -j LOG --log-prefix "SecAuto-ATTACK: "; \
    iptables -A INPUT -p tcp --dport $API_PORT -m recent --update --seconds 300 --hitcount 20 --name secauto_attacks -j DROP; \
    \
    echo "SecAuto firewall rules applied successfully"'

# Cleanup firewall rules on stop
ExecStop=/bin/bash -c '\
    API_PORT=${SECAUTO_API_PORT:-9090}; \
    \
    # Remove SecAuto-specific rules \
    iptables -D INPUT -p tcp --dport $API_PORT -s 10.0.0.0/8 -j ACCEPT 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -s 172.16.0.0/12 -j ACCEPT 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -s 192.168.0.0/16 -j ACCEPT 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -s 127.0.0.1 -j ACCEPT 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -j LOG --log-prefix "SecAuto-BLOCKED: " 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -j DROP 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -m limit --limit 60/min --limit-burst 10 -j ACCEPT 2>/dev/null || true; \
    \
    # Clean up attack tracking \
    iptables -D INPUT -p tcp --dport $API_PORT -m recent --set --name secauto_attacks 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -m recent --update --seconds 300 --hitcount 20 --name secauto_attacks -j LOG --log-prefix "SecAuto-ATTACK: " 2>/dev/null || true; \
    iptables -D INPUT -p tcp --dport $API_PORT -m recent --update --seconds 300 --hitcount 20 --name secauto_attacks -j DROP 2>/dev/null || true; \
    \
    echo "SecAuto firewall rules removed"'

# Environment
Environment=SECAUTO_API_PORT=9090

# Security
PrivateTmp=yes
ProtectSystem=yes
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target