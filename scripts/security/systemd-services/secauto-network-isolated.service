[Unit]
Description=SecAuto SOAR Platform (Network Isolated)
Documentation=https://github.com/your-org/secauto
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/secauto-jail

[Service]
Type=simple
User=root
Group=root

# Create isolated network namespace
ExecStartPre=/bin/bash -c '\
    # Create network namespace \
    ip netns add secauto-ns 2>/dev/null || true; \
    \
    # Set up loopback interface in namespace \
    ip netns exec secauto-ns ip link set lo up; \
    \
    # Create veth pair for controlled network access \
    ip link add secauto-veth0 type veth peer name secauto-veth1 2>/dev/null || true; \
    \
    # Move one end to namespace \
    ip link set secauto-veth1 netns secauto-ns; \
    \
    # Configure host side \
    ip addr add 10.254.0.1/24 dev secauto-veth0 2>/dev/null || true; \
    ip link set secauto-veth0 up; \
    \
    # Configure namespace side \
    ip netns exec secauto-ns ip addr add 10.254.0.2/24 dev secauto-veth1; \
    ip netns exec secauto-ns ip link set secauto-veth1 up; \
    ip netns exec secauto-ns ip route add default via 10.254.0.1; \
    \
    # Set up iptables rules for controlled access \
    iptables -t nat -A POSTROUTING -s 10.254.0.2 -j MASQUERADE 2>/dev/null || true; \
    \
    # Allow only specific outbound connections (if needed) \
    # iptables -A FORWARD -s 10.254.0.2 -d DNS_SERVER -p udp --dport 53 -j ACCEPT; \
    # iptables -A FORWARD -s 10.254.0.2 -p tcp --dport 443 -j ACCEPT; \
    \
    # Block all other outbound traffic from namespace \
    iptables -A FORWARD -s 10.254.0.2 -j DROP 2>/dev/null || true; \
    \
    # Ensure jail environment is ready \
    mkdir -p /opt/secauto-jail/var/{run,log} && chown secauto:secauto /opt/secauto-jail/var/{run,log}; \
    mkdir -p /opt/secauto-jail/tmp && chown secauto:secauto /opt/secauto-jail/tmp; \
    '

# Run SecAuto in network namespace and chroot jail
ExecStart=/bin/bash -c '\
    ip netns exec secauto-ns chroot /opt/secauto-jail /bin/su -s /opt/secauto/secauto secauto'

# Cleanup on stop
ExecStopPost=/bin/bash -c '\
    # Remove iptables rules \
    iptables -t nat -D POSTROUTING -s 10.254.0.2 -j MASQUERADE 2>/dev/null || true; \
    iptables -D FORWARD -s 10.254.0.2 -j DROP 2>/dev/null || true; \
    \
    # Remove veth interface \
    ip link del secauto-veth0 2>/dev/null || true; \
    \
    # Remove network namespace \
    ip netns del secauto-ns 2>/dev/null || true; \
    '

# Graceful shutdown
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=3

# Working directory
WorkingDirectory=/opt/secauto

# Environment variables
Environment=SECAUTO_CONFIG=/opt/secauto/config.yaml
Environment=SECAUTO_JAIL=true
Environment=SECAUTO_NETWORK_ISOLATED=true
Environment=SECAUTO_LOG_LEVEL=INFO

# Security Hardening - Maximum Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/secauto-jail
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes

# Network is handled by network namespace, but still restrict syscalls
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @cpu-emulation @obsolete @reboot @swap @raw-io
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=4096
LimitNPROC=128
LimitFSIZE=1G
MemoryMax=1G
CPUQuota=60%
TasksMax=512

# Remove all capabilities
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target