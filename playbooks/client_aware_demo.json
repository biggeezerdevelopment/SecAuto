[
  {
    "comment": "Demo playbook showing client-aware integration usage"
  },
  {
    "run": "client_aware_demo",
    "integration_name": "test_client_integration"
  },
  {
    "if": {
      "conditions": [
        ["==", {"var": "client_aware_demo.success"}, true]
      ],
      "true": {
        "run": "client_virustotal_scanner",
        "urls": ["https://example.com", "https://google.com"]
      },
      "false": {
        "log": "Client awareness demo failed"
      }
    }
  },
  {
    "cache": {
      "key": "demo_results",
      "value": {
        "client_demo": {"var": "client_aware_demo"},
        "virustotal_demo": {"var": "client_virustotal_scanner"}
      }
    }
  }
]